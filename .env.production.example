# =============================================================================
# Stitches Africa — PRODUCTION profile (Vercel / production deploy)
# =============================================================================
# Set these in Vercel project settings — do not commit filled values.
# =============================================================================

APP_ENV=production
NEXT_PUBLIC_APP_URL=https://www.stitchesafrica.com
NEXT_PUBLIC_BASE_URL=https://www.stitchesafrica.com
DISABLE_REAL_PAYOUTS=false

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=stitches-africa.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=stitches-africa
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=stitches-africa.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=

# Live payment keys — production only
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=

NEXT_PUBLIC_PAYSTACK_LIVE_PUBLIC_KEY=pk_live_
PAYSTACK_SECRET_KEY=sk_live_
PAYSTACK_SPLIT_CODE=

NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-
FLW_SECRET_KEY=FLWSECK-

JWT_SECRET=
STITCHES_EMAIL_API_URL=
STITCHES_BACKEND_EMAIL_API_KEY=

MINTSOFT_WEBHOOK_BASE_URL=https://www.stitchesafrica.com
MINTSOFT_BASE_URL=https://api.mintsoft.co.uk
# ... see .env.example for full list
