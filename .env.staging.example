# LOCAL + STAGING FIREBASE — cp to .env.staging then npm run dev:staging

APP_ENV=staging
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
DISABLE_REAL_PAYOUTS=true

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=stitches-africa-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=stitches-africa-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=stitches-africa-dev.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=
FIREBASE_PROJECT_ID=stitches-africa-dev
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

JWT_SECRET=change-me-staging-jwt-secret-min-32-chars

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_PAYSTACK_LIVE_PUBLIC_KEY=pk_test_
PAYSTACK_SECRET_KEY=sk_test_
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-
FLW_SECRET_KEY=FLWSECK_TEST-

STITCHES_EMAIL_API_URL=
STITCHES_BACKEND_EMAIL_API_KEY=
EMAIL_PREVIEW_SECRET=staging-preview-secret
OPENAI_API_KEY=
MINTSOFT_WEBHOOK_BASE_URL=http://localhost:3000
MINTSOFT_BASE_URL=

STAGING_PROD_PROJECT_ID=stitches-africa
STAGING_PROJECT_ID=stitches-africa-dev

# Prod read credentials (staging:clone-user only — read-only from production)
PROD_FIREBASE_PROJECT_ID=stitches-africa
PROD_FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=
# Or: PROD_FIREBASE_CLIENT_EMAIL= + PROD_FIREBASE_PRIVATE_KEY=

STAGING_CLONE_PASSWORD=StagingTest123!
STAGING_SEED_PASSWORD=StagingTest123!
